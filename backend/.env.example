# Copiar a backend/.env; uvicorn carga este archivo con --env-file.
SCAA_ENV=dev
# Si es relativa, la ruta se resuelve desde la raíz del repositorio.
SCAA_DATA_ROOT=.localdata
ARASAAC_BASE_URL=https://api.arasaac.org/api
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo provisional para las sondas, pendiente de evaluación de calidad.
OLLAMA_MODEL=qwen2.5:1.5b
# Para el candidato en validación, usar qwen3:4b-instruct y alternate.
OLLAMA_PROMPT_PROFILE=baseline
OLLAMA_TIMEOUT=60
